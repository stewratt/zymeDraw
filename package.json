{
  "name": "zymedraw",
  "private": true,
  "version": "0.3.0",
  "description": "Deck — a card-constrained, destructive image editor",
  "author": "stewratt",
  "type": "module",
  "main": "electron/main.js",
  "desktopName": "zyme-draw.desktop",
  "scripts": {
    "install:all": "npm install && npm install --prefix frontend && npm install --prefix backend",
    "dev": "concurrently -n frontend,backend,ml -c blue,green,magenta \"npm run dev --prefix frontend\" \"npm run dev --prefix backend\" \"node backend/ml/start.js\"",
    "build": "npm run build --prefix frontend",
    "start": "concurrently -n backend,ml -c green,magenta \"node backend/server.js\" \"node backend/ml/start.js\"",
    "electron": "electron .",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.stewratt.zyme",
    "productName": "ZYME",
    "asar": false,
    "files": [
      "electron/**",
      "backend/**",
      "!backend/ml/.venv/**",
      "!backend/ml/__pycache__/**",
      "!backend/ml/tools/**",
      "frontend/dist/**"
    ],
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "frontend/public/logo/icon.png",
      "category": "Graphics",
      "executableName": "zyme-draw",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "Name": "Draw",
          "X-Zyme-Glyph": "Dr"
        }
      }
    },
    "deb": {
      "packageName": "zyme-draw",
      "artifactName": "zyme-draw_${version}_${arch}.${ext}",
      "fpm": ["--category", "graphics"],
      "maintainer": "stewratt <stewratt@users.noreply.github.com>",
      "priority": "optional",
      "depends": [
        "libgtk-3-0t64 | libgtk-3-0",
        "libnss3",
        "libasound2t64 | libasound2",
        "libgbm1",
        "libnotify4",
        "libxss1",
        "libxtst6",
        "libatspi2.0-0t64 | libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "xdg-utils"
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "icon": "frontend/public/logo/icon.png"
    },
    "win": {
      "target": "nsis",
      "icon": "frontend/public/logo/icon.png"
    },
    "publish": {
      "provider": "github"
    }
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  }
}
