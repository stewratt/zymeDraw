node_modules/
dist/
.DS_Store
.deck-config.json
*.log
output/

# Per-machine Claude Code permissions (the gh allowances /execute needs).
# Machine-local by design — never committed.
.claude/settings.local.json

# ---- Images ----
# Ignored EVERYWHERE by default: Deck sessions work through large local
# input/output folders that must never land in git. ONE exception rule:
# an image is tracked iff the app is broken without it, and every such
# image lives under frontend/ — assets/cards/ (starter faces),
# assets/plates/ (blank Foundry plates + geometry template), public/
# (textures, logo). Nothing lands in those folders unless it ships,
# pre-compressed (pngquant — see CLAUDE.md §6).
*.png
*.jpg
*.jpeg
*.webp
!frontend/src/assets/**/*.png
!frontend/src/assets/**/*.jpg
!frontend/public/**/*.png
!frontend/public/**/*.jpg

# Local workshop, never committed: full-res plate masters (originals/ +
# the uncompressed punched set) and the fonts overlay, which mixes OFL
# zips with proprietary faces (Beleren, MPlantin) that must not be
# redistributed. The shipping plates live compressed in
# frontend/src/assets/plates/.
card_template/

# Debug loop artifacts (binary screenshots; the findings .md stays tracked)
debug_loop_screenshots/
.gstack/

# ML sidecar: per-machine Python env + caches. The .onnx model in
# backend/ml/models/ IS tracked — it ships with the repo.
backend/ml/.venv/
__pycache__/
