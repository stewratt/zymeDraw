node_modules/
dist/
.DS_Store
.deck-config.json
*.log
output/
*.png
*.jpg

# Exception: the two Foundry card-design template images are tracked.
!foundry_card_template.png
!foundry_card_template@3x.png

# Exception: card designs ship with the repo so a fresh clone is never blank
# (main faces + default Foundry cardbacks). This is the ONE folder where PNGs
# are tracked — keep exports, panel art, and WIP scratch out of it.
!frontend/src/assets/cards/*.png
!frontend/src/assets/cards/*.jpg

# Foundry materials: local-only, never committed. The plates carry the same
# trademark caution as card art, and the fonts folder mixes OFL zips with
# proprietary faces (Beleren, MPlantin) that must not be redistributed.
# OFL fonts get unzipped into frontend/src/assets/fonts/ (tracked) at
# Phase 4; proprietary ones stay here as a local overlay.
card_template/

# Debug loop artifacts (binary screenshots; the findings .md stays tracked)
debug_loop_screenshots/
.gstack/

# ML sidecar (Phase 7): per-machine Python env + caches. The .onnx model
# in backend/ml/models/ IS tracked — it ships with the repo.
backend/ml/.venv/
__pycache__/
